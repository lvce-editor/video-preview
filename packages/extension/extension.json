{
  "id": "builtin.video-preview",
  "name": "Video Preview",
  "description": "Video Preview",
  "repository": "https://github.com/lvce-editor/video-preview",
  "browser": "dist/videoPreviewMain.js",
  "isolated": true,
  "workerName": "Video Preview Extension Worker",
  "activation": ["onView:builtin.video-preview"],
  "languages": [],
  "views": [
    {
      "id": "builtin.video-preview",
      "title": "Video Preview",
      "kind": "virtualDom",
      "type": "preview",
      "css": "media/index.css",
      "selector": [".mp4", ".mov", ".avi", ".wmv", ".avchd", ".webm", ".ogv", ".flv"],
      "showSideBarHeader": false
    }
  ]
}
